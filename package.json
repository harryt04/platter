{
  "name": "platter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k -n web,realtime,worker \"npm:dev:web\" \"npm:dev:realtime\" \"npm:dev:worker\"",
    "dev:web": "next dev",
    "dev:realtime": "tsx watch server/realtime/index.ts",
    "dev:worker": "tsx watch server/worker/index.ts",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "build": "next build --webpack && tsup --config tsup.config.ts",
    "start:web": "next start",
    "start:realtime": "node dist/realtime/index.mjs",
    "start:worker": "node dist/worker/index.mjs",
    "format": "prettier --write .",
    "prettify": "npm run format",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project component",
    "test:watch": "vitest",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "db:indexes": "tsx scripts/db/indexes.ts",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:seed:test-user": "tsx scripts/seed/test-user.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@agendajs/mongo-backend": "^4.0.3",
    "@better-auth/mongo-adapter": "^1.7.3",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@serwist/turbopack": "^9.5.12",
    "@socket.io/mongo-adapter": "^0.4.0",
    "@socket.io/mongo-emitter": "^0.2.0",
    "agenda": "^6.2.6",
    "better-auth": "^1.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.4",
    "decimal.js": "^10.6.0",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^1.1.7",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.468.0",
    "mongodb": "^7.6.0",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.13",
    "posthog-js": "^1.429.1",
    "posthog-node": "^5.51.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "serwist": "^9.5.12",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "fast-check": "^4.9.0",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  }
}
